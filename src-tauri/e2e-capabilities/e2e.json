{
  "identifier": "e2e",
  "description": "Test-only capability granting fixture shims and the minimum WebdriverIO window-inspection bridge. Added at runtime under `--features e2e` and never included in a release build.",
  "windows": ["main"],
  "permissions": [
    "allow-e2e-open-path",
    "allow-e2e-save-path",
    "allow-e2e-queue-open-path",
    "allow-e2e-queue-save-path",
    "allow-e2e-arm-minimize-probe",
    "allow-e2e-arm-navigation-probe",
    "allow-e2e-arm-operation-gate",
    "allow-e2e-force-autosave-cycle",
    "allow-e2e-minimize-observation",
    "allow-e2e-navigation-observation",
    "allow-e2e-operation-gate-reached",
    "allow-e2e-release-operation-gate",
    "allow-e2e-queue-external-confirmation",
    "allow-e2e-take-external-action",
    "core:window:allow-is-minimized",
    "wdio:allow-execute",
    "wdio:allow-get-active-window-label",
    "wdio:allow-get-window-states",
    "wdio:allow-list-windows"
  ]
}
